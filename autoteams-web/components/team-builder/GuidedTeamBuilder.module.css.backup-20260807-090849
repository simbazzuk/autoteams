.page {
  min-height: 100vh;
  color: #f5f7fb;
  background: #0f1420;
}

.hero {
  padding: 58px 0 48px;
  background:
    radial-gradient(circle at 84% 14%, rgba(79,142,247,.16), transparent 30%),
    radial-gradient(circle at 12% 8%, rgba(118,95,255,.14), transparent 30%),
    #0f1420;
  border-bottom: 1px solid #232c3e;
}

.heroGrid {
  display: grid;
  grid-template-columns: minmax(0,1.25fr) minmax(310px,.75fr);
  gap: 24px;
  align-items: center;
}

.hero h1 {
  max-width: 900px;
  margin: 10px 0 14px;
  font-size: clamp(50px,5vw,70px);
  line-height: 1.02;
  letter-spacing: -.05em;
}

.hero p {
  max-width: 810px;
  margin: 0;
  color: #9ca8bb;
  font-size: 17px;
  line-height: 1.65;
}

.contextCard {
  display: grid;
  grid-template-columns: auto minmax(0,1fr);
  gap: 14px;
  align-items: center;
  padding: 23px;
  background: #171e2d;
  border: 1px solid #2e3950;
  border-radius: 20px;
}

.contextCard > div {
  display: grid;
  gap: 4px;
}

.contextCard small {
  color: #8d99ac;
  font-size: 10px;
}

.contextCard strong {
  color: #f1f4f9;
  font-size: 18px;
}

.contextCard p {
  margin: 0;
  color: #7f8ba0;
  font-size: 11px;
}

.body {
  padding: 28px 0 80px;
}

.message {
  padding: 14px;
  margin-bottom: 14px;
  color: #bdebd4;
  background: rgba(45,166,112,.09);
  border: 1px solid rgba(73,196,139,.22);
  border-radius: 13px;
  font-size: 12px;
}

.steps {
  display: grid;
  grid-template-columns: repeat(5,minmax(0,1fr));
  gap: 8px;
  margin-bottom: 15px;
}

.steps button {
  display: grid;
  grid-template-columns: auto minmax(0,1fr);
  gap: 9px;
  align-items: center;
  padding: 12px;
  color: inherit;
  background: #171e2d;
  border: 1px solid #2a3448;
  border-radius: 13px;
  text-align: left;
  opacity: .6;
  cursor: pointer;
}

.steps button > span {
  display: grid;
  width: 34px;
  height: 34px;
  place-items: center;
  color: #9ca8bb;
  background: #252e40;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 800;
}

.steps button > div {
  display: grid;
  gap: 2px;
}

.steps strong {
  color: #e8ecf3;
  font-size: 11px;
}

.steps small {
  color: #7f8ba0;
  font-size: 8px;
}

.steps .activeStep,
.steps .completeStep {
  opacity: 1;
}

.steps .activeStep {
  background: linear-gradient(145deg,#211d3b,#171e2d);
  border-color: #61568d;
}

.steps .activeStep > span {
  color: #fff;
  background: linear-gradient(135deg,#765fff,#4f8ef7);
}

.steps .completeStep > span {
  color: #55d69a;
  background: rgba(45,166,112,.12);
}

.panel {
  padding: 23px;
  background: #171e2d;
  border: 1px solid #2a3448;
  border-radius: 19px;
}

.panel > h2,
.sectionHeading h2 {
  margin: 8px 0 6px;
  color: #f1f4f9;
  font-size: 29px;
}

.intro,
.sectionHeading p {
  max-width: 780px;
  margin: 0;
  color: #8f9bb0;
  font-size: 12px;
  line-height: 1.5;
}

.twoColumns {
  display: grid;
  grid-template-columns: minmax(0,1.3fr) minmax(320px,.7fr);
  gap: 15px;
  align-items: start;
}

.sideStack {
  display: grid;
  gap: 13px;
}

.form,
.requirementForm {
  display: grid;
  gap: 14px;
  margin-top: 16px;
}

.form > label,
.requirementForm > label {
  display: grid;
  gap: 7px;
  color: #b4bdcc;
  font-size: 12px;
  font-weight: 700;
}

.form input,
.form textarea,
.form select,
.requirementForm input,
.requirementForm textarea,
.requirementForm select {
  width: 100%;
  color: #f1f4f9;
  background: #111725;
  border: 1px solid #354158;
  border-radius: 11px;
  font-size: 13px;
}

.form input,
.form select,
.requirementForm input,
.requirementForm select {
  min-height: 46px;
  padding: 0 12px;
}

.form textarea,
.requirementForm textarea {
  min-height: 105px;
  padding: 12px;
  resize: vertical;
}

.form input:focus,
.form textarea:focus,
.form select:focus,
.requirementForm input:focus,
.requirementForm textarea:focus,
.requirementForm select:focus {
  outline: none;
  border-color: #7868ff;
  box-shadow: 0 0 0 4px rgba(118,95,255,.12);
}

.groupList {
  display: grid;
  gap: 9px;
  margin-top: 17px;
}

.groupList button {
  display: grid;
  grid-template-columns: auto minmax(0,1fr) auto;
  gap: 11px;
  align-items: center;
  padding: 13px;
  color: inherit;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 13px;
  text-align: left;
  cursor: pointer;
}

.groupList button:hover {
  border-color: #514979;
}

.groupList button > div {
  display: grid;
  gap: 3px;
}

.groupList strong {
  color: #e8ecf3;
  font-size: 13px;
}

.groupList small,
.groupList p {
  color: #7f8ba0;
  font-size: 9px;
}

.groupList p {
  margin: 0;
}

.groupList button > span:last-child {
  color: #a99cff;
  font-size: 9px;
}

.sectionHeading {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: start;
  margin-bottom: 17px;
}

.sectionHeading > strong {
  color: #a99cff;
  font-size: 12px;
}

.peopleGrid {
  display: grid;
  gap: 8px;
}

.peopleGrid > label {
  display: grid;
  grid-template-columns: auto auto minmax(0,1fr);
  gap: 10px;
  align-items: center;
  padding: 12px;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 12px;
  cursor: pointer;
}

.peopleGrid > label.selectedPerson {
  background: linear-gradient(135deg,#282442,#202641);
  border-color: #61568d;
}

.peopleGrid input {
  width: 16px;
  height: 16px;
  accent-color: #765fff;
}

.avatar {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  color: #fff;
  background: linear-gradient(135deg,#765fff,#4f8ef7);
  border-radius: 12px;
  font-size: 13px;
  font-weight: 800;
}

.peopleGrid label > div {
  display: grid;
  gap: 3px;
}

.peopleGrid strong {
  color: #e8ecf3;
  font-size: 12px;
}

.peopleGrid small {
  color: #8f9bb0;
  font-size: 9px;
}

.peopleGrid em {
  color: #6f7c91;
  font-size: 8px;
  font-style: normal;
}

.footerActions,
.formActions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 17px;
}

.demoCard {
  display: grid;
  gap: 10px;
  padding: 18px;
  background:
    radial-gradient(circle at 90% 8%, rgba(79,142,247,.1), transparent 28%),
    linear-gradient(145deg,#211d3b,#171e2d);
  border: 1px solid #514979;
  border-radius: 15px;
}

.demoCard h3 {
  margin: 0;
  color: #f1f4f9;
  font-size: 20px;
}

.demoCard p {
  margin: 0;
  color: #8f9bb0;
  font-size: 11px;
  line-height: 1.5;
}

.requirementForm {
  grid-template-columns: repeat(3,minmax(0,1fr));
}

.fullWidth {
  grid-column: 1 / -1;
}

.requirementForm fieldset {
  padding: 0;
  border: 0;
}

.requirementForm legend {
  margin-bottom: 8px;
  color: #b4bdcc;
  font-size: 12px;
  font-weight: 700;
}

.skillGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 7px;
}

.skillGrid label {
  display: flex;
  gap: 7px;
  align-items: center;
  padding: 10px;
  color: #9ca8bb;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 10px;
  font-size: 10px;
  cursor: pointer;
}

.skillGrid label.selectedSkill {
  color: #fff;
  background: #292442;
  border-color: #61568d;
}

.skillGrid input {
  width: 15px;
  min-height: auto;
  height: 15px;
  padding: 0;
  accent-color: #765fff;
}

.summaryBanner {
  display: grid;
  grid-template-columns: auto minmax(0,1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 15px;
  margin-bottom: 13px;
  background: linear-gradient(125deg,#241153,#5a3ac7 65%,#3e88ee);
  border-radius: 14px;
}

.summaryBanner > div {
  display: grid;
  gap: 3px;
}

.summaryBanner small {
  color: #ded9f2;
  font-size: 9px;
}

.summaryBanner strong {
  color: #fff;
  font-size: 16px;
}

.summaryBanner p {
  margin: 0;
  color: #ded9f2;
  font-size: 10px;
}

.summaryBanner > span {
  padding: 7px 9px;
  color: #fff;
  background: rgba(255,255,255,.12);
  border-radius: 999px;
  font-size: 10px;
}

.rankingList {
  display: grid;
  gap: 8px;
}

.rankingList > article {
  display: grid;
  grid-template-columns: auto auto minmax(0,1fr) auto;
  gap: 10px;
  align-items: center;
  padding: 12px;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 12px;
}

.rankingList > article.chosenPerson {
  background: linear-gradient(135deg,#282442,#202641);
  border-color: #61568d;
}

.rank {
  display: grid;
  width: 28px;
  height: 28px;
  place-items: center;
  color: #a99cff;
  background: #292442;
  border-radius: 9px;
  font-size: 9px;
  font-weight: 800;
}

.personEvidence {
  display: grid;
  gap: 8px;
}

.personEvidence header {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.personEvidence header > div {
  display: grid;
  gap: 3px;
}

.personEvidence strong {
  color: #e8ecf3;
  font-size: 12px;
}

.personEvidence small {
  color: #8f9bb0;
  font-size: 9px;
}

.personEvidence em {
  color: #55d69a;
  font-size: 9px;
  font-style: normal;
}

.personEvidence > div {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.personEvidence > div span {
  padding: 5px 7px;
  color: #9fd7bc;
  background: rgba(45,166,112,.08);
  border-radius: 999px;
  font-size: 8px;
}

.personEvidence > div span.concern {
  color: #e2b267;
  background: rgba(226,178,103,.08);
}

.rankingList article > button {
  padding: 8px 10px;
  color: #a99cff;
  background: #292442;
  border: 0;
  border-radius: 9px;
  font-size: 9px;
  cursor: pointer;
}

.confidence {
  padding: 8px 10px;
  color: #55d69a;
  background: rgba(45,166,112,.12);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
}

.confirmGrid {
  display: grid;
  grid-template-columns: minmax(0,1.3fr) minmax(300px,.7fr);
  gap: 14px;
}

.finalTeam,
.decisionCard {
  padding: 18px;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 15px;
}

.finalTeam h3,
.decisionCard h3 {
  margin: 8px 0 6px;
  color: #f1f4f9;
  font-size: 22px;
}

.finalTeam > p {
  margin: 0 0 15px;
  color: #8f9bb0;
  font-size: 11px;
  line-height: 1.5;
}

.finalPeople {
  display: grid;
  gap: 7px;
}

.finalPeople article {
  display: grid;
  grid-template-columns: auto minmax(0,1fr);
  gap: 9px;
  align-items: center;
  padding: 10px;
  background: #171e2d;
  border: 1px solid #293246;
  border-radius: 10px;
}

.finalPeople article > div {
  display: grid;
  gap: 3px;
}

.finalPeople strong {
  color: #e8ecf3;
  font-size: 11px;
}

.finalPeople small {
  color: #7f8ba0;
  font-size: 8px;
}

.decisionCard {
  display: grid;
  align-content: start;
  gap: 10px;
  background:
    radial-gradient(circle at 90% 8%, rgba(79,142,247,.1), transparent 28%),
    linear-gradient(145deg,#211d3b,#171e2d);
  border-color: #514979;
}

.decisionCard > div {
  display: grid;
  gap: 7px;
}

.decisionCard > div span {
  padding: 9px;
  color: #c9d0db;
  background: #121827;
  border: 1px solid #293246;
  border-radius: 9px;
  font-size: 9px;
}

.decisionCard p {
  margin: 0;
  color: #8f9bb0;
  font-size: 9px;
}

.empty {
  display: grid;
  justify-items: center;
  padding: 34px;
  text-align: center;
  background: #121827;
  border: 1px dashed #354158;
  border-radius: 14px;
}

.empty h3 {
  margin: 12px 0 5px;
  color: #e8ecf3;
  font-size: 19px;
}

.empty p {
  margin: 0;
  color: #7f8ba0;
  font-size: 10px;
  line-height: 1.5;
}

.loading {
  padding: 48px;
  color: #9ca8bb;
  text-align: center;
}

@media (max-width: 1050px) {
  .heroGrid,
  .twoColumns,
  .confirmGrid {
    grid-template-columns: 1fr;
  }

  .steps {
    grid-template-columns: repeat(3,minmax(0,1fr));
  }

  .skillGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 760px) {
  .steps,
  .requirementForm,
  .skillGrid {
    grid-template-columns: 1fr;
  }

  .fullWidth {
    grid-column: auto;
  }

  .sectionHeading {
    align-items: stretch;
    flex-direction: column;
  }

  .summaryBanner,
  .rankingList > article {
    grid-template-columns: 1fr;
  }
}
