"use client";

import Link from "next/link";
import {
  useEffect,
  useMemo,
  useState,
} from "react";
import {
  getRecommendationById,
} from "@/lib/firebase/recommendation-detail";
import {
  listRecommendationsForWorkspace,
  type RecommendationHistoryRecord,
} from "@/lib/firebase/recommendation-persistence";
import {
  loadActiveWorkspaceId,
} from "@/lib/workspaces";
import {
  buildTeamHealth,
  candidateName,
  memberDifferences,
} from "@/lib/recommendations/recommendation-insights";
import styles from "./RecommendationCompare.module.css";

export function RecommendationCompare() {
  const [
    recommendations,
    setRecommendations,
  ] = useState<
    RecommendationHistoryRecord[]
  >([]);

  const [
    leftId,
    setLeftId,
  ] = useState("");

  const [
    rightId,
    setRightId,
  ] = useState("");

  const [
    left,
    setLeft,
  ] = useState<
    RecommendationHistoryRecord | null
  >(null);

  const [
    right,
    setRight,
  ] = useState<
    RecommendationHistoryRecord | null
  >(null);

  const [
    loading,
    setLoading,
  ] = useState(true);

  const [
    error,
    setError,
  ] = useState("");

  useEffect(() => {
    const params =
      new URLSearchParams(
        window.location.search,
      );

    setLeftId(
      params.get("left") || "",
    );

    setRightId(
      params.get("right") || "",
    );

    void loadOptions();
  }, []);

  useEffect(() => {
    void loadSelected();
  }, [
    leftId,
    rightId,
  ]);

  async function loadOptions() {
    try {
      const workspaceId =
        loadActiveWorkspaceId();

      if (!workspaceId) {
        return;
      }

      setRecommendations(
        await listRecommendationsForWorkspace(
          workspaceId,
        ),
      );
    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Unable to load recommendation list.",
      );
    } finally {
      setLoading(false);
    }
  }

  async function loadSelected() {
    try {
      setLeft(
        leftId
          ? await getRecommendationById(
              leftId,
            )
          : null,
      );

      setRight(
        rightId
          ? await getRecommendationById(
              rightId,
            )
          : null,
      );
    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Unable to compare recommendations.",
      );
    }
  }

  const differences =
    useMemo(
      () =>
        left && right
          ? memberDifferences(
              left,
              right,
            )
          : [],
      [left, right],
    );

  const leftHealth =
    left
      ? buildTeamHealth(
          left,
        )
      : null;

  const rightHealth =
    right
      ? buildTeamHealth(
          right,
        )
      : null;

  return (
    <section className={styles.card}>
      <div className={styles.heading}>
        <div>
          <span className="eyebrow">
            Compare
          </span>
          <h2>
            Compare recommendations.
          </h2>
          <p>
            Understand how two recommendations differ
            in team membership, confidence, evidence
            and overall team health.
          </p>
        </div>
      </div>

      <div className={styles.selectors}>
        <label>
          Recommendation A
          <select
            value={leftId}
            onChange={(event) =>
              setLeftId(
                event.target.value,
              )
            }
          >
            <option value="">
              Select recommendation
            </option>
            {recommendations.map(
              (record) => (
                <option
                  key={record.id}
                  value={record.id}
                >
                  {record.requirement.name ||
                    "Recommendation"}{" "}
                  · {record.source} ·{" "}
                  {record.confidence}%
                </option>
              ),
            )}
          </select>
        </label>

        <label>
          Recommendation B
          <select
            value={rightId}
            onChange={(event) =>
              setRightId(
                event.target.value,
              )
            }
          >
            <option value="">
              Select recommendation
            </option>
            {recommendations.map(
              (record) => (
                <option
                  key={record.id}
                  value={record.id}
                >
                  {record.requirement.name ||
                    "Recommendation"}{" "}
                  · {record.source} ·{" "}
                  {record.confidence}%
                </option>
              ),
            )}
          </select>
        </label>
      </div>

      {error && (
        <div className={styles.error}>
          {error}
        </div>
      )}

      {loading ? (
        <div className={styles.empty}>
          Loading recommendations…
        </div>
      ) : !left || !right ? (
        <div className={styles.empty}>
          Select two recommendations to compare.
        </div>
      ) : (
        <>
          <div className={styles.columns}>
            <CompareCard
              label="Recommendation A"
              record={left}
              health={
                leftHealth!
              }
            />

            <CompareCard
              label="Recommendation B"
              record={right}
              health={
                rightHealth!
              }
            />
          </div>

          <section className={styles.diff}>
            <div>
              <span className="eyebrow">
                Team differences
              </span>
              <h3>
                Who changed?
              </h3>
            </div>

            <div className={styles.diffList}>
              {differences.map(
                (item) => (
                  <article
                    key={item.personId}
                  >
                    <strong>
                      {item.name}
                    </strong>

                    <span
                      data-state={
                        item.state
                      }
                    >
                      {item.state ===
                      "both"
                        ? "Both"
                        : item.state ===
                            "left-only"
                          ? "Only A"
                          : "Only B"}
                    </span>
                  </article>
                ),
              )}
            </div>
          </section>
        </>
      )}

      <footer>
        <Link
          className="button secondary"
          href="/recommendation-history"
        >
          ← Recommendation History
        </Link>
      </footer>
    </section>
  );
}

function CompareCard({
  label,
  record,
  health,
}: {
  label: string;
  record: RecommendationHistoryRecord;
  health: ReturnType<
    typeof buildTeamHealth
  >;
}) {
  return (
    <article className={styles.compareCard}>
      <span className="eyebrow">
        {label}
      </span>

      <h3>
        {record.requirement.name}
      </h3>

      <p>
        {record.summary}
      </p>

      <div className={styles.badges}>
        <span>
          {record.source}
        </span>
        <span>
          {record.status}
        </span>
      </div>

      <div className={styles.scores}>
        <Metric
          label="Confidence"
          value={`${record.confidence}%`}
        />
        <Metric
          label="Health"
          value={`${health.overall}%`}
        />
        <Metric
          label="Skill coverage"
          value={`${health.skillCoverage}%`}
        />
        <Metric
          label="Risk readiness"
          value={`${health.risk}%`}
        />
      </div>

      <div className={styles.members}>
        <strong>
          Recommended team
        </strong>

        {record.recommendedPersonIds.map(
          (personId) => (
            <span key={personId}>
              {candidateName(
                record,
                personId,
              )}
            </span>
          ),
        )}
      </div>

      <Link
        href={`/recommendation-history/${record.id}`}
      >
        View full recommendation →
      </Link>
    </article>
  );
}

function Metric({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <span>
      <small>{label}</small>
      <strong>{value}</strong>
    </span>
  );
}
