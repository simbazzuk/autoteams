.menu {
  position: relative;
}

.trigger {
  display: grid;
  grid-template-columns: auto minmax(0, auto) auto;
  gap: 9px;
  align-items: center;
  min-height: 44px;
  padding: 5px 11px 5px 6px;
  color: #edf1f7;
  background: #171e2d;
  border: 1px solid #2a3448;
  border-radius: 14px;
  cursor: pointer;
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    transform 0.18s ease;
}

.trigger:hover {
  background: #1d2535;
  border-color: #4d466f;
  transform: translateY(-1px);
}

.avatar,
.largeAvatar {
  display: grid;
  place-items: center;
  color: white;
  background: linear-gradient(135deg, #7868ff, #4f8ef7);
  font-weight: 800;
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 12px;
}

.largeAvatar {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  font-size: 15px;
}

.identity {
  display: grid;
  min-width: 0;
  gap: 1px;
  text-align: left;
}

.identity strong {
  max-width: 128px;
  overflow: hidden;
  color: #f1f4f9;
  font-size: 13px;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity small {
  max-width: 128px;
  overflow: hidden;
  color: #7f8ba0;
  font-size: 10px;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trigger em {
  color: #7f8ba0;
  font-size: 11px;
  font-style: normal;
}

.dropdown {
  position: absolute;
  z-index: 200;
  top: calc(100% + 10px);
  right: 0;
  width: 270px;
  padding: 10px;
  color: #edf1f7;
  background: #171e2d;
  border: 1px solid #354058;
  border-radius: 16px;
  box-shadow: 0 26px 75px rgba(0, 0, 0, 0.42);
}

.header {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 11px;
  align-items: center;
  padding: 10px;
}

.header > div {
  display: grid;
  min-width: 0;
  gap: 3px;
}

.header strong {
  overflow: hidden;
  color: #f1f4f9;
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header small {
  color: #8f9bb0;
  font-size: 12px;
}

.links {
  display: grid;
  gap: 3px;
}

.links a,
.signOut {
  display: flex;
  width: 100%;
  min-height: 39px;
  align-items: center;
  padding: 8px 10px;
  color: #aab4c4;
  background: transparent;
  border: 0;
  border-radius: 9px;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
}

.links a:hover,
.signOut:hover {
  color: #f1f4f9;
  background: #232b3b;
}

.divider {
  height: 1px;
  margin: 7px 4px;
  background: #2a3448;
}

.signOut {
  color: #ff9ba4;
}

@media (max-width: 760px) {
  .identity {
    display: none;
  }

  .trigger {
    grid-template-columns: auto auto;
  }
}
