.menu {
  position: relative;
}

.trigger {
  display: grid;
  grid-template-columns: auto minmax(0, auto) auto;
  gap: 9px;
  min-height: 44px;
  padding: 5px 11px 5px 6px;
  align-items: center;
  color: #eef1f7;
  background: #171e2d;
  border: 1px solid #2a3448;
  border-radius: 14px;
  cursor: pointer;
  list-style: none;
}

.trigger::-webkit-details-marker {
  display: none;
}

.trigger:hover {
  background: #1d2535;
  border-color: #46516a;
}

.avatar {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  object-fit: cover;
  color: #fff;
  background: linear-gradient(
    135deg,
    #7868ff,
    #4f8ef7
  );
  border-radius: 50%;
  font-size: 12px;
  font-weight: 800;
}

.largeAvatar {
  width: 46px;
  height: 46px;
  font-size: 16px;
}

.identity {
  display: grid;
  min-width: 0;
  gap: 1px;
}

.identity strong {
  max-width: 130px;
  overflow: hidden;
  color: #f5f7fb;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity small {
  color: #7f8ba0;
  font-size: 8px;
}

.chevron {
  color: #768298;
  font-size: 9px;
}

.dropdown {
  position: absolute;
  z-index: 100;
  top: calc(100% + 8px);
  right: 0;
  display: grid;
  min-width: 285px;
  padding: 10px;
  background: #151c2a;
  border: 1px solid #303b50;
  border-radius: 15px;
  box-shadow: 0 22px 55px rgba(0,0,0,.38);
}

.profile {
  display: grid;
  grid-template-columns: auto minmax(0,1fr);
  gap: 11px;
  align-items: center;
  padding: 9px;
}

.profile > div {
  display: grid;
  gap: 3px;
}

.profile strong {
  color: #f2f5fa;
  font-size: 12px;
}

.profile small {
  overflow: hidden;
  color: #9ca8bb;
  font-size: 9px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile span {
  color: #7f8ba0;
  font-size: 8px;
}

.dropdown > a,
.dropdown > button {
  padding: 10px 11px;
  color: #c7cfdd;
  background: transparent;
  border: 0;
  border-radius: 9px;
  font: inherit;
  font-size: 10px;
  text-align: left;
  cursor: pointer;
}

.dropdown > a:hover,
.dropdown > button:hover {
  color: #fff;
  background: #20293a;
}

.divider {
  height: 1px;
  margin: 6px 3px;
  background: #293246;
}

.error {
  margin: 7px 6px 2px;
  color: #e2b267;
  font-size: 9px;
}

.signInButton {
  display: inline-flex;
  gap: 8px;
  min-height: 42px;
  padding: 6px 13px;
  align-items: center;
  color: #edf1f8;
  background: #171e2d;
  border: 1px solid #2a3448;
  border-radius: 13px;
  cursor: pointer;
}

.googleMark {
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  color: #fff;
  background: linear-gradient(
    135deg,
    #a855f7,
    #4f8ef7
  );
  border-radius: 8px;
  font-size: 11px;
  font-weight: 900;
}

.signInButton > span:last-child {
  font-size: 10px;
  font-weight: 700;
}

.loading {
  display: grid;
  width: 48px;
  height: 42px;
  place-items: center;
}

.loading span {
  width: 22px;
  height: 22px;
  border: 2px solid #293246;
  border-top-color: #7868ff;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
