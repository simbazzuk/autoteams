import { TeamSciencePrinciples } from "@/components/recommendation-detail/TeamSciencePrinciples";
"use client";

import Link from "next/link";
import {
  useEffect,
  useMemo,
  useState,
} from "react";
import {
  getRecommendationById,
} from "@/lib/firebase/recommendation-detail";
import type {
  RecommendationHistoryRecord,
} from "@/lib/firebase/recommendation-persistence";
import {
  buildTeamHealth,
  candidateName,
  rankedReasonForPerson,
} from "@/lib/recommendations/recommendation-insights";
import {
  RecommendationLifecycleActions,
} from "@/components/recommendation-history/RecommendationLifecycleActions";
import {
  RecommendationTimeline,
} from "@/components/recommendation-detail/RecommendationTimeline";
import styles from "./RecommendationDetail.module.css";

export function RecommendationDetail({
  recommendationId,
}: {
  recommendationId: string;
}) {
  const [
    record,
    setRecord,
  ] = useState<
    RecommendationHistoryRecord | null
  >(null);

  const [
    loading,
    setLoading,
  ] = useState(true);

  const [
    error,
    setError,
  ] = useState("");

  const [
    timelineRefreshKey,
    setTimelineRefreshKey,
  ] = useState(0);

  async function refresh() {
    setLoading(true);
    setError("");

    try {
      const next =
        await getRecommendationById(
          recommendationId,
        );

      setRecord(next);

      if (!next) {
        setError(
          "Recommendation not found or you do not have access.",
        );
      }
    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Unable to load recommendation.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void refresh();
  }, [recommendationId]);

  const health =
    useMemo(
      () =>
        record
          ? buildTeamHealth(
              record,
            )
          : null,
      [record],
    );

  if (loading) {
    return (
      <section className={styles.state}>
        Loading recommendation…
      </section>
    );
  }

  if (!record || !health) {
    return (
      <section className={styles.state}>
        {error ||
          "Recommendation unavailable."}
      </section>
    );
  }

  return (
    <section className={styles.page}>
      <header className={styles.hero}>
        <div>
          <div className={styles.badges}>
            <span>
              {record.source ===
              "gemini"
                ? "Gemini"
                : "Deterministic"}
            </span>
            <span>
              {record.status}
            </span>
          </div>

          <h1>
            {record.requirement.name ||
              "Team Recommendation"}
          </h1>

          <p>
            {record.summary}
          </p>
        </div>

        <div className={styles.confidence}>
          <small>
            Confidence
          </small>
          <strong>
            {record.confidence}%
          </strong>
        </div>
      </header>

      <div className={styles.metadata}>
        <Meta
          label="Created"
          value={new Date(
            record.createdAtIso,
          ).toLocaleString()}
        />
        <Meta
          label="Engine"
          value={
            record.source
          }
        />
        <Meta
          label="Model"
          value={
            record.model || "—"
          }
        />
        <Meta
          label="Candidates"
          value={String(
            record.candidates.length,
          )}
        />
      </div>

      <section className={styles.health}>
        <div>
          <span className="eyebrow">
            Team health
          </span>
          <h2>
            Recommendation scorecard
          </h2>
        </div>

        <div className={styles.healthGrid}>
          <Score
            label="Overall"
            value={health.overall}
          />
          <Score
            label="Confidence"
            value={health.confidence}
          />
          <Score
            label="Skill coverage"
            value={health.skillCoverage}
          />
          <Score
            label="Balance"
            value={health.balance}
          />
          <Score
            label="Risk readiness"
            value={health.risk}
          />
        </div>
      </section>

      <section className={styles.team}>
        <div>
          <span className="eyebrow">
            Selected team
          </span>
          <h2>
            Why each person was selected
          </h2>
        </div>

        <div className={styles.people}>
          {record.recommendedPersonIds.map(
            (personId) => {
              const insight =
                rankedReasonForPerson(
                  record,
                  personId,
                );

              return (
                <article
                  key={personId}
                >
                  <header>
                    <div>
                      <strong>
                        {candidateName(
                          record,
                          personId,
                        )}
                      </strong>
                      <small>
                        {record.candidates.find(
                          (candidate) =>
                            candidate.id ===
                            personId,
                        )?.jobTitle ||
                          "Team member"}
                      </small>
                    </div>

                    <span>
                      {insight.score ??
                        "—"}
                      {insight.score !==
                        undefined
                        ? "%"
                        : ""}
                    </span>
                  </header>

                  <div>
                    {insight.reasons.map(
                      (reason) => (
                        <p
                          key={
                            reason
                          }
                          className={
                            styles.reason
                          }
                        >
                          ✓ {reason}
                        </p>
                      ),
                    )}

                    {insight.concerns.map(
                      (concern) => (
                        <p
                          key={
                            concern
                          }
                          className={
                            styles.concern
                          }
                        >
                          △ {concern}
                        </p>
                      ),
                    )}
                  </div>
                </article>
              );
            },
          )}
        </div>
      </section>

      <section className={styles.evidence}>
        <Evidence
          title="Team strengths"
          values={
            record.teamStrengths
          }
        />
        <Evidence
          title="Skill gaps"
          values={
            record.skillGaps
          }
        />
        <Evidence
          title="Risks"
          values={
            record.risks
          }
        />
      </section>

      <section className={styles.lifecycle}>
        <div>
          <span className="eyebrow">
            Decision workflow
          </span>
          <h2>
            Review this recommendation
          </h2>
        </div>

        {record.reviewerNote && (
          <blockquote>
            {record.reviewerNote}
          </blockquote>
        )}

        <RecommendationLifecycleActions
          recommendationId={
            record.id
          }
          status={
            record.status
          }
          onChanged={() => {
            setTimelineRefreshKey(
              (value) =>
                value + 1,
            );
            void refresh();
          }}
        />
      </section>

      <TeamSciencePrinciples />

      <RecommendationTimeline
        recommendation={
          record
        }
        refreshKey={
          timelineRefreshKey
        }
      />

      <footer className={styles.actions}>
        <Link
          className="button secondary"
          href="/recommendation-history"
        >
          ← Recommendation History
        </Link>

        <Link
          className="button"
          href={`/recommendation-compare?left=${record.id}`}
        >
          Compare Recommendation
        </Link>
      </footer>
    </section>
  );
}

function Score({
  label,
  value,
}: {
  label: string;
  value: number;
}) {
  return (
    <article>
      <small>{label}</small>
      <strong>{value}%</strong>
      <div>
        <span
          style={{
            width: `${value}%`,
          }}
        />
      </div>
    </article>
  );
}

function Meta({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <article>
      <small>{label}</small>
      <strong>{value}</strong>
    </article>
  );
}

function Evidence({
  title,
  values,
}: {
  title: string;
  values: string[];
}) {
  return (
    <article>
      <strong>{title}</strong>
      {values.length > 0 ? (
        values.map(
          (value) => (
            <span key={value}>
              {value}
            </span>
          ),
        )
      ) : (
        <span>
          None identified.
        </span>
      )}
    </article>
  );
}
