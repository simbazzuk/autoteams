.page{max-width:1180px;margin:auto;padding:42px 28px 80px;color:#eef2f8}.hero{display:grid;grid-template-columns:1fr 230px;gap:30px;align-items:end}.hero>div>span,.future span{color:#ff9f43;font-size:11px;font-weight:900;letter-spacing:.12em}.hero h1{font-size:48px;margin:8px 0}.hero p,.card p,.future p,.atlas p{color:#96a3b6;line-height:1.65}.hero aside{padding:20px;background:#151d2c;border:1px solid #303a50;border-radius:18px}.hero aside strong{font-size:27px}.hero aside small{color:#8996aa}.hero aside div,.progress>div{height:7px;margin-top:12px;background:#252f42;border-radius:999px;overflow:hidden}.hero i,.progress i{display:block;height:100%;background:linear-gradient(90deg,#7868ff,#4f8cff)}.atlas{display:flex;gap:13px;margin:28px 0;padding:18px;background:rgba(120,104,255,.08);border:1px solid rgba(120,104,255,.24);border-radius:17px}.atlas p{margin:4px 0 0;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.card{display:grid;gap:14px;padding:24px;background:#141c2b;border:1px solid #2d374c;border-radius:20px}.card header{display:flex;justify-content:space-between}.card header b{font-size:28px}.card header em{height:max-content;padding:5px 8px;color:#8fe1ba;border:1px solid rgba(48,190,120,.2);border-radius:999px;font-size:8px;font-style:normal}.card>small{color:#8491a5;font-size:9px;text-transform:uppercase}.card h2{margin:0;font-size:23px}.card p{margin:0;font-size:13px}.progress span{display:flex;justify-content:space-between;color:#8491a5;font-size:9px}.card>a{width:max-content;padding:9px 12px;color:#fff;background:#202a3d;border:1px solid #344159;border-radius:10px;text-decoration:none;font-size:10px;font-weight:800}.future{margin-top:22px;padding:23px;border:1px dashed #344158;border-radius:18px}.future h2{margin:7px 0}.future p{margin:0}@media(max-width:760px){.page{padding:28px 16px 70px}.hero,.grid{grid-template-columns:1fr}.hero h1{font-size:36px}}
