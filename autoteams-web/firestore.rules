rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User account document: owner can read/update, but account deletion
    // should be handled separately from profile/persona deletion.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      // A user owns their own AutoTeams personas/profiles.
      match /personas/{personaId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Saved AutoTeams teams.
    // TeamPersistenceBridge writes ownerId on every persisted team and
    // includes the owner in memberIds.
    match /teams/{teamId} {
      // Owners can always read their team. A signed-in member can read a
      // team only when their Firebase UID is explicitly present in memberIds.
      allow read: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || (
            resource.data.memberIds is list
            && request.auth.uid in resource.data.memberIds
          )
        );

      // A user may only create a team owned by themselves.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // Only the existing owner may change a team, and ownership cannot be
      // transferred by an ordinary client update.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      // Only the existing owner may permanently delete a saved team.
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Deny everything that has not been explicitly allowed above.
      // AutoTeams invitations - v7.13.42
  // Token is the document ID. A recipient may GET a known invitation token,
  // but anonymous listing/querying of invitations is prohibited.
  match /invitations/{token} {
    allow get: if true;
    allow list: if false;

    allow create: if request.auth != null
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.token == token;

    allow update, delete: if request.auth != null
      && resource.data.ownerId == request.auth.uid
      && request.resource.data.ownerId == request.auth.uid;
  }

// AutoTeams recommendation history - v7.13.79
  // Free-trial model: recommendation history is owned by the Firebase user
  // who generated it. Workspace-wide shared history can be introduced later
  // once workspace membership is authoritative in Firestore.
  match /recommendations/{recommendationId} {
    allow create: if request.auth != null
      && request.resource.data.createdBy == request.auth.uid;

    allow read: if request.auth != null
      && resource.data.createdBy == request.auth.uid;

    allow update: if request.auth != null
      && resource.data.createdBy == request.auth.uid
      && request.resource.data.createdBy == request.auth.uid;

    allow delete: if request.auth != null
      && resource.data.createdBy == request.auth.uid;
  }
// AUTOTEAMS_V7157156_SHARED_OPPORTUNITIES
    match /opportunities/{opportunityId} {
      allow read: if request.auth != null
        && (
          resource.data.status == "open"
          || resource.data.ownerId == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /opportunityInterests/{interestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(
            /databases/$(database)/documents/opportunities/$(resource.data.opportunityId)
          ).data.ownerId == request.auth.uid
        );

      allow update: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(
            /databases/$(database)/documents/opportunities/$(resource.data.opportunityId)
          ).data.ownerId == request.auth.uid
        );

      allow delete: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || get(
            /databases/$(database)/documents/opportunities/$(resource.data.opportunityId)
          ).data.ownerId == request.auth.uid
        );
    }

    
    // AutoTeams Opportunity invitations - v7.15.7.15.9.1
    // Owners create/manage invitations. Recipients may read and respond only.
    match /opportunityInvitations/{invitationId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );

      allow update: if request.auth != null
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.recipientId == resource.data.recipientId
          )
          ||
          (
            resource.data.recipientId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.recipientId == resource.data.recipientId
            && request.resource.data.opportunityId == resource.data.opportunityId
            && request.resource.data.interestId == resource.data.interestId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "respondedAt", "updatedAt"])
            && request.resource.data.status in ["accepted", "declined"]
          )
        );

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // A recipient may update only their own Opportunity interest response.
    // Existing Opportunity interest rules continue to govern all other access.
    match /opportunityInterests/{interestId} {
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.opportunityId == resource.data.opportunityId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["accepted", "declined"];
    }

    // ----------------------------------------------------------------------
    // AUTOTEAMS_V715715245_MESSAGING_RULES
    // Participant-aware TeamScience messaging.
    // ----------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function teamDocument(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    function opportunityDocument(opportunityId) {
      return get(/databases/$(database)/documents/opportunities/$(opportunityId));
    }

    function canUseTeamConversation(data) {
      return signedIn()
        && data.type == "team"
        && data.entityId is string
        && exists(/databases/$(database)/documents/teams/$(data.entityId))
        && (
          teamDocument(data.entityId).data.ownerId == request.auth.uid
          || (
            teamDocument(data.entityId).data.memberIds is list
            && request.auth.uid in teamDocument(data.entityId).data.memberIds
          )
        );
    }

    function validOpportunityConversation(data) {
      return signedIn()
        && data.type == "opportunity"
        && data.entityId is string
        && data.ownerId is string
        && data.candidateId is string
        && data.scope == data.candidateId
        && data.participantIds is list
        && data.participantIds.size() == 2
        && data.ownerId in data.participantIds
        && data.candidateId in data.participantIds
        && request.auth.uid in data.participantIds
        && exists(/databases/$(database)/documents/opportunities/$(data.entityId))
        && opportunityDocument(data.entityId).data.ownerId == data.ownerId;
    }

    function canUseConversation(data) {
      return canUseTeamConversation(data)
        || validOpportunityConversation(data);
    }

    match /conversations/{conversationId} {
      // A conversation can only be created by an authenticated participant.
      // Opportunity ownership is checked against the authoritative
      // opportunities document. Team access is checked against the team doc.
      allow create: if canUseConversation(request.resource.data);

      // Existing conversation metadata can only be read by authorised users.
      allow read: if canUseConversation(resource.data);

      // Participants may update only an existing conversation they can use,
      // and must preserve security-defining fields.
      allow update: if canUseConversation(resource.data)
        && request.resource.data.type == resource.data.type
        && request.resource.data.entityId == resource.data.entityId
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.candidateId == resource.data.candidateId
        && request.resource.data.participantIds == resource.data.participantIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canUseConversation(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );

        allow create: if canUseConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // ----------------------------------------------------------------------
    // AUTOTEAMS_V71571525_MESSAGE_INBOX_RULES
    // Per-user message inbox references.
    // ----------------------------------------------------------------------
    match /messageInboxes/{userId}/conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds
        && userId in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds
        && request.resource.data.userId == userId
        && request.resource.data.conversationId == conversationId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
match /{document=**} {
      allow read, write: if false;
    }
  }
}

