"use client";
import { doc, getDoc, serverTimestamp, setDoc } from "firebase/firestore";
import { getFirebaseFirestore } from "@/lib/firebase/client";
import { waitForFirebaseUser } from "@/lib/firebase/auth-ready";
import { loadPeople, type WorkspacePerson } from "@/lib/workspaces";
export type PeopleMigrationResult={userId:string;localPeopleCount:number;migratedPeopleCount:number;skippedPeopleCount:number;workspaceCounts:Record<string,number>};
export async function migrateLocalPeopleToFirestore():Promise<PeopleMigrationResult>{const user=await waitForFirebaseUser();if(!user)throw new Error("Sign in with Firebase before migrating people.");const people=loadPeople();const db=getFirebaseFirestore();let migratedPeopleCount=0,skippedPeopleCount=0;const workspaceCounts:Record<string,number>={};for(const p of people){const ref=doc(db,"people",p.id);const existing=await getDoc(ref);if(existing.exists()&&existing.data().workspaceId&&existing.data().workspaceId!==p.workspaceId){skippedPeopleCount++;continue}await setDoc(ref,{...clean(p),migratedFrom:"localStorage",migrationVersion:"v4.0-phase4",migratedBy:user.uid,updatedAt:serverTimestamp(),...(existing.exists()?{}:{cloudCreatedAt:serverTimestamp()})},{merge:true});migratedPeopleCount++;workspaceCounts[p.workspaceId]=(workspaceCounts[p.workspaceId]||0)+1}await setDoc(doc(db,"migrationStatus",user.uid),{userId:user.uid,peopleMigration:"complete",localPeopleCount:people.length,migratedPeopleCount,skippedPeopleCount,peopleWorkspaceCounts:workspaceCounts,peoplePhase:"v4.0-phase4",peopleCompletedAt:serverTimestamp()},{merge:true});return{userId:user.uid,localPeopleCount:people.length,migratedPeopleCount,skippedPeopleCount,workspaceCounts}}
function clean(p:WorkspacePerson):Record<string,unknown>{return Object.fromEntries(Object.entries(p).filter(([,v])=>v!==undefined))}
