import {
  collection,
  doc,
  getDocs,
  setDoc,
} from "firebase/firestore";
import {
  getFirebaseFirestore,
} from "@/lib/firebase/client";
import type {
  Workspace,
} from "@/lib/workspaces";
import type {
  WorkspaceRepository,
} from "@/lib/repositories/types";

export class FirebaseWorkspaceRepository
  implements WorkspaceRepository
{
  async list(): Promise<Workspace[]> {
    const db =
      getFirebaseFirestore();

    const snapshot =
      await getDocs(
        collection(
          db,
          "workspaces",
        ),
      );

    return snapshot.docs.map(
      (item) =>
        item.data() as Workspace,
    );
  }

  async save(
    workspaces: Workspace[],
  ): Promise<void> {
    const db =
      getFirebaseFirestore();

    await Promise.all(
      workspaces.map(
        (workspace) =>
          setDoc(
            doc(
              db,
              "workspaces",
              workspace.id,
            ),
            workspace,
            { merge: true },
          ),
      ),
    );
  }

  async getActiveId(): Promise<string> {
    throw new Error(
      "Firebase active-workspace persistence is introduced in Phase 2.",
    );
  }

  async setActiveId(): Promise<void> {
    throw new Error(
      "Firebase active-workspace persistence is introduced in Phase 2.",
    );
  }
}
